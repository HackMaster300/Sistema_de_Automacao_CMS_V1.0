# Configuração local — nunca commitar coordenadas/caminhos reais
config/appsettings.yaml

# Dados reais de clientes — nunca commitar
data/*.csv
data/*.xlsx
data/*.xlsm
!data/sample_identifiers.csv

# Logs de execução (podem conter dados processados)
logs/*
!logs/.gitkeep

# Build / empacotamento
dist/
build/
*.egg-info/

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
